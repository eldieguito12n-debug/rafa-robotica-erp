============================= CONFIGURACIÓN BACKEND =============================

# BASE DE DATOS: Por defecto SQLite (sin instalación extra). PostgreSQL si tienes:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/robolab_erp
DATABASE_URL=sqlite:///./robolab_erp.db

# SEGURIDAD JWT - CAMBIA ESTA CLAVE EN PRODUCCIÓN
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_y_larga_2026_abcXYZ123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - dominios permitidos para acceder al API
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Carpeta de subida de archivos (avatares, planos, PDFs)
UPLOAD_DIR=./uploads

# ====== OPCIONALES (descomenta si quieres usar estas características) ======

# EMAIL SMTP (para recuperar contraseña y notificaciones)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=tu_contraseña_app
# SMTP_FROM=no-reply@robolab.com

# IA ASISTENTE (OpenAI)
# OPENAI_API_KEY=sk-...

# IA ASISTENTE (Anthropic Claude)
# ANTHROPIC_API_KEY=sk-ant-...

# IA ASISTENTE (Google Gemini)
# GOOGLE_API_KEY=...

# IA ASISTENTE (OpenRouter)
# OPEN_ROUTER_API_KEY=sk-or-v1-...
