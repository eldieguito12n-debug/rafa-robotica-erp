{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api|assets|.*\\..*|_next).*)", "destination": "/index.html" },
    { "source": "/api/v1/:path*", "destination": "/api/v1/:path*" }
  ],
  "env": {
    "VITE_API_URL": "/api/v1"
  }
}
